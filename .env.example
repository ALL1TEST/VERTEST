# Supabase Database Configuration for Prisma
# 1. DATABASE_URL: Transaction pooler URL (port 6543) with ?pgbouncer=true (or session pooler)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct database connection URL (port 5432) used for Prisma migrations/db push
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Standard CMS connection token (set in Vercel environment variables)
CMS_CONNECTION_TOKEN="your_cms_connection_token_here"
